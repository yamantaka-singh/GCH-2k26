{
  "type": "object",
  "required": ["cameras", "skipped"],
  "additionalProperties": false,
  "properties": {
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "lat", "lon"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180},
          "external_ref": {"type": "string"},
          "address": {"type": "string"},
          "kind": {"type": "string", "enum": ["analog", "ip"]},
          "vendor": {"type": "string"},
          "model": {"type": "string"},
          "rtsp_url": {"type": "string"},
          "resolution": {"type": "string"},
          "storage": {"type": "string", "enum": ["local", "cloud", "unknown"]},
          "fps": {"type": "integer", "minimum": 1},
          "retention_days": {"type": "integer", "minimum": 0},
          "note": {"type": "string"}
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_row", "reason"],
        "additionalProperties": false,
        "properties": {
          "source_row": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
